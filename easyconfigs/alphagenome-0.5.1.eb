# Ruoshi Sun
# 2026-01-27
easyblock = 'Conda'

name = 'alphagenome'
version = '0.5.1'

homepage = 'https://github.com/google-deepmind/alphagenome'
description = """
AlphaGenome offers multimodal predictions, encompassing diverse functional
outputs such as gene expression, splicing patterns, chromatin features, and
contact maps. The model analyzes DNA sequences of up to 1 million base pairs in
length and can deliver predictions at single base-pair resolution for most
outputs. AlphaGenome achieves state-of-the-art performance across a range of
genomic prediction benchmarks, including numerous diverse variant effect
prediction tasks.
"""

toolchain = SYSTEM

builddependencies = [
    ('miniforge', '24.11.3', '-py3.12'),
]

requirements = 'python=3.12 numpy scipy matplotlib seaborn'

postinstallcmds = [
    '%(installdir)s/bin/pip install git+https://github.com/google-deepmind/alphagenome@v%(version)s',
]
moduleclass = 'bio'
