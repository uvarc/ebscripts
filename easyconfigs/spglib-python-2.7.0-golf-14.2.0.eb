easyblock = 'PythonBundle'

name = 'spglib-python'
version = '2.7.0'

homepage = 'https://pypi.python.org/pypi/spglib'
description = """Spglib for Python.

Spglib is a library for finding and handling crystal symmetries written in C.
"""

toolchain = {'name': 'golf', 'version': '14.2.0'}

builddependencies = [
    ('scikit-build-core', '0.11.5'),
]

dependencies = [
    ('Python', '3.13.11'),
    ('Python-bundle-PyPI', '2025.07'),
    ('SciPy-bundle', '2025.07'),
    ('pybind11', '3.0.1'),
]

exts_list = [
    ('typing-extensions', '4.14.1', {
        'sources': ['typing_extensions-%(version)s.tar.gz'],
        'checksums': ['38b39f4aeeab64884ce9f74c94263ef78f3c22467c8724005483154c26648d36'],
    }),
    ('pyproject_metadata', '0.9.1'),
    ('spglib', version),
]

moduleclass = 'chem'
