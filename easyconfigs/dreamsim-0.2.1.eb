easyblock = 'Conda'

name = 'dreamsim'
version = '0.2.1'

homepage = 'https://github.com/ssundaram21/dreamsim'
description = """
DreamSim: Learning New Dimensions of Human Visual Similarity using Synthetic Data (NeurIPS 2023 Spotlight)
"""

toolchain = SYSTEM

builddependencies = [
    ('miniforge', '26.7.2'),
]

channels = ['conda-forge']
requirements = 'python=3.13'

postinstallcmds = [
    '%(installdir)s/bin/pip install --prefix=%(installdir)s %(name)s==%(version)s',
]

moduleclass = 'bio'
