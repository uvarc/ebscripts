# from EB github repo
# modified Ruoshi Sun
# 2023-04-03

easyblock = 'ConfigureMake'

name = 'cairo'
version = '1.17.4'

homepage = 'https://cairographics.org'
description = """Cairo is a 2D graphics library with support for multiple output devices.
 Currently supported output targets include the X Window System (via both Xlib and XCB), Quartz, Win32, image buffers,
 PostScript, PDF, and SVG file output. Experimental backends include OpenGL, BeOS, OS/2, and DirectFB"""

toolchain = {'name': 'GCC', 'version': '11.4.0'}

source_urls = ['https://cairographics.org/snapshots/']
sources = [SOURCE_TAR_XZ]

builddependencies = [
    ('pkgconf', '1.9.5'),
]

dependencies = [
    ('bzip2', '1.0.6', '', SYSTEM),
    ('zlib', '1.2.13'),
    ('libpng', '1.6'),
    ('freetype', '2'),
    ('fontconfig', '2.14.2'),
    ('GLib', '2'),
    ('pixman', '0.42.2'),
]

# disable symbol lookup, which requires -lbfd, to avoid link issues with (non-PIC) libiberty.a provided by GCC
configopts = "--enable-symbol-lookup=no --enable-gobject=yes --enable-svg=yes --enable-tee=yes --enable-ft=yes --enable-fc=yes" # --enable-xlib-xcb "
#configopts = "--buildtype=release"

sanity_check_paths = {
    'files': ['bin/cairo-trace',
              'lib/libcairo.%s' % SHLIB_EXT,
              'lib/libcairo-gobject.%s' % SHLIB_EXT,
              ],
    'dirs': ['lib/pkgconfig'],
}

moduleclass = 'vis'
