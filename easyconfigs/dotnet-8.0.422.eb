# Ruoshi Sun
# 2026-06-22
easyblock = 'Tarball'

name = 'dotnet'
version = '8.0.422'

homepage = 'https://dotnet.microsoft.com/en-us/'
description = """.NET is a free, cross-platform, open source developer platform for building many different types
 of applications."""

toolchain = SYSTEM

source_urls = ['https://builds.dotnet.microsoft.com/dotnet/Sdk/%(version)s/']
sources = ['%(name)s-sdk-%(version)s-linux-x64.tar.gz']

sanity_check_paths = {
    'files': ['dotnet'],
    'dirs': []
}

modextrapaths = {
    'PATH': [''],
    'LD_LIBRARY_PATH': ['shared/Microsoft.NETCore.App/8.0.28'],
    'DOTNET_ROOT': [''],
}

moduleclass = 'lang'
