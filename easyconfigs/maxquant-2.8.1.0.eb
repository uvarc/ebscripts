easyblock = 'Tarball'

name = 'maxquant'
version = '2.8.1.0'

homepage = 'https://maxquant.org/maxquant'
description = """MaxQuant is a quantitative proteomics software package designed for analyzing large
 mass-spectrometric data sets. It is specifically aimed at high-resolution MS data. Several labeling
 techniques as well as label-free quantification are supported."""

toolchain = SYSTEM

download_instructions = """
To download the MaxQuant source tarball, register at:
    https://www.maxquant.org/download_asset/maxquant/latest
You should receive a unique download URL via email.
"""

sources = ['MaxQuant_v%(version)s.zip']

dependencies = [
    ('dotnet', '8')
]

sanity_check_paths = {
    'files': ['bin/MaxQuantCmd.dll', 'bin/MaxQuantGui.dll'],
    'dirs': [],
}

sanity_check_commands = [
    ("dotnet $EBROOTMAXQUANT/bin/MaxQuantCmd.dll --version 2>&1 | grep -q %(version)s", ''),
    ("dotnet $EBROOTMAXQUANT/bin/MaxQuantCmd.dll --help 2>&1 | grep -q USAGE", ''),
]

modaliases = {
    'maxquantcmd': 'dotnet $EBROOTMAXQUANT/bin/MaxQuantCmd.dll',
}

modloadmsg = """
To run MaxQuant in command-line mode:
maxquantcmd <options>

GUI not supported in Linux
"""

moduleclass = 'bio'
