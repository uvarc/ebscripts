easyblock = 'ConfigureMake'

name = 'FFmpeg'
version = '9.0'

homepage = 'https://www.ffmpeg.org/'
description = "A complete, cross-platform solution to record, convert and stream audio and video."

toolchain = {'name': 'GCC', 'version': '14.2.0'}

source_urls = [homepage + 'releases']
sources = [SOURCELOWER_TAR_XZ]

builddependencies = [
    ('binutils', '2.45'),
    ('pkgconf', '2.4.3'),
    #('ffnvcodec', '13.0.19.0', '', SYSTEM),  # optional nvenc/dec support
    ('NASM', '3.02'),
]
dependencies = [
    ('zlib', '1.3.1'),
    ('bzip2', '1.0.8'),
    ('x264', '20250619', '', SYSTEM),
    ('lame', '3.100', '', SYSTEM),
    ('x265', '4.1', '', SYSTEM),
    #('dav1d', '1.5.3'),
    ('SVT-AV1', '3.1.2'),
    ('libaom', '3.10.0'),
    #('libvpx', '1.16.0'),
    ('libwebp', '1.6.0'),
    ('libvorbis', '1.3.7'),
    ('libopus', '1.5.2'),
    ('X11', '20250608'),
    ('freetype', '2'),
    ('fontconfig', '2.17.1'),
    ('FriBidi', '1.0.16'),
    ('SDL2', '2.32.10'),
]

#--enable-libvpx --enable-libdav1d 
configopts = ' '.join([
    '--enable-pic --enable-shared --enable-gpl --enable-version3 --cc="$CC" --cxx="$CXX"',
    '--enable-nonfree --enable-libx264 --enable-libx265 --enable-libmp3lame',
    '--enable-libwebp --enable-libvorbis --enable-libopus',
    '--enable-libaom --enable-libsvtav1',
    '--enable-libfreetype --enable-fontconfig --enable-libfribidi --enable-sdl2 --disable-htmlpages',
])

sanity_check_paths = {
    'files': [f'bin/ff{x}' for x in ['mpeg', 'probe', 'play']] +
             [f'lib/lib{x}.{y}' for x in ['avdevice', 'avfilter', 'avformat', 'avcodec',
                                          'swresample', 'swscale', 'avutil'] for y in [SHLIB_EXT, 'a']],
    'dirs': ['include']
}

moduleclass = 'vis'
