easyblock = 'Conda'
name = 'isoseq'
version = '26.2.0'

homepage = 'https://github.com/PacificBiosciences/IsoSeq'
description = """IsoDeq3 is a Scalable De Novo Isoform Discovery"""

toolchain = SYSTEM

builddependencies = [
    ('miniforge', '26.3.2'),
]

channels = ['conda-forge', 'bioconda']

requirements = "python=3.13 %(name)s=%(version)s"

moduleclass = 'bio'
