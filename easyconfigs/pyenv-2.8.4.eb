# Ruoshi Sun
# 2026-08-21 RIV-20898
easyblock = 'Tarball'

name = 'pyenv'
version = '2.8.4'

homepage = 'https://pipenv.pypa.io/en/latest/'
description = """
pyenv lets you easily switch between multiple versions of Python. It's simple,
unobtrusive, and follows the UNIX tradition of single-purpose tools that do one
thing well."""

toolchain = SYSTEM

source_urls = ['https://github.com/pyenv/pyenv/archive/refs/tags']
sources = ['v%(version)s.tar.gz']

sanity_check_paths = {
    'files': ['bin/pyenv'],
    'dirs': ['bin'],
}

modextravars = {'PYENV_ROOT': '$HOME/.pyenv'}
moduleclass = 'tools'
