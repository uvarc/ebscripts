# Ruoshi Sun
# 2026-06-18
easyblock = 'Conda'

name = 'gdc-client'
version = '2.3'

homepage = 'https://github.com/NCI-GDC/gdc-client'
description = """The gdc-client provides several convenience functions over
 the GDC API which provides general download/upload via HTTPS."""

toolchain = SYSTEM

builddependencies = [
    ('miniforge', '26.1.0'),
]

channels = ['conda-forge', 'bioconda']
requirements = 'python=3.13 %(name)s=%(version)s'

sanity_check_paths = {
    'files': ['bin/gdc-client'],
    'dirs': ['bin']
}

moduleclass = 'tools'
