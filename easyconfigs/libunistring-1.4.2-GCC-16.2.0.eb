easyblock = 'ConfigureMake'

name = 'libunistring'
version = '1.4.2'

homepage = 'https://www.gnu.org/software/libunistring/'

description = """This library provides functions for manipulating Unicode strings and for
 manipulating C strings according to the Unicode standard."""

toolchain = {'name': 'GCC', 'version': '16.2.0'}
toolchainopts = {'pic': True}

source_urls = ['https://ftp.gnu.org/gnu/libunistring']
sources = [SOURCELOWER_TAR_XZ]
#patches = ['libunistring-1.4.1_glibc-2.43-compatibility.patch']
checksums = [
    {'libunistring-1.4.2.tar.xz': '5b46e74377ed7409c5b75e7a96f95377b095623b689d8522620927964a41499c'},
    {'libunistring-1.4.1_glibc-2.43-compatibility.patch':
     'a27f942bc3cdbead6c0492d7252cff3da29190ab7b2ebf4f0ea57a45bc3ed946'},
]

builddependencies = [
    ('binutils', '2.47'),
]

dependencies = [
    ('libiconv', '1.19'),
]

maxparallel = 1

sanity_check_paths = {
    'files': ['lib/libunistring.a', 'lib/libunistring.%s' % SHLIB_EXT] +
             ['include/uni%s.h' % x for x in ['case', 'conv', 'ctype', 'lbrk', 'name', 'norm',
                                              'stdio', 'str', 'types', 'wbrk', 'width']],
    'dirs': ['include/unistring'],
}

moduleclass = 'lib'
