name = 'Boost'
version = '1.91.0'

homepage = 'https://www.boost.org/'
description = """Boost provides free peer-reviewed portable C++ source libraries."""

toolchain = {'name': 'GCC', 'version': '16.2.0'}
toolchainopts = {'pic': True}

source_urls = ['https://archives.boost.io/release/%(version)s/source/']
sources = ['boost_%s.tar.gz' % '_'.join(version.split('.'))]
checksums = ['5734305f40a76c30f951c9abd409a45a2a19fb546efe4162119250bbe4d3a463']

builddependencies = [
    ('binutils', '2.47'),
]

dependencies = [
    ('bzip2', '1.0.8'),
    ('zlib', '2.3.3'),
    ('XZ', '5.8.3'),
    ('zstd', '1.5.7'),
    ('ICU', '78.3'),
]

configopts = '--without-libraries=python,mpi'

# disable MPI, build Boost libraries with tagged layout
boost_mpi = False
tagged_layout = True

moduleclass = 'devel'
