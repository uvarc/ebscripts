easyblock = 'ConfigureMake'

name = 'libiconv'
version = '1.19'

homepage = 'https://www.gnu.org/software/libiconv'
description = "Libiconv converts from one character encoding to another through Unicode conversion"

toolchain = {'name': 'GCC', 'version': '16.2.0'}

source_urls = ['https://ftp.gnu.org/gnu/%(name)s']
sources = [SOURCE_TAR_GZ]
checksums = ['88dd96a8c0464eca144fc791ae60cd31cd8ee78321e67397e25fc095c4a19aa6']

builddependencies = [('binutils', '2.47')]

sanity_check_paths = {
    'files': ['bin/iconv', 'include/iconv.h', 'include/libcharset.h', 'include/localcharset.h',
              'lib/libcharset.a', 'lib/libcharset.%s' % SHLIB_EXT, 'lib/libiconv.%s' % SHLIB_EXT],
    'dirs': ['share'],
}

moduleclass = 'lib'
