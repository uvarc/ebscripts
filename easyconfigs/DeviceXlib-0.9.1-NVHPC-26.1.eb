easyblock = 'ConfigureMake'

name = 'DeviceXlib'
version = '0.9.1'

homepage = 'https://gitlab.com/max-centre/components/devicexlib'

whatis = ['Description: fortran library wrapping device-oriented routines and utilities"']

description = """
DeviceXlib is a library that wraps device-oriented routines and utilities, such as device
data allocation, host-device data transfers. deviceXlib supports CUDA language, together
with OpenACC and OpenMP programming paradigms. deviceXlib wraps a subset of functions from
Nvidia cuBLAS, Intel oneMKL BLAS and AMD rocBLAS libraries.
"""

toolchain = {'name': 'NVHPC', 'version': '26.1'}
toolchainopts = {
    'openmp': True,
    'debug': True, 'opt': True,
    'extra_f90flags': '-Mpreprocess -Mfree' #-cpp'
}

source_urls = ['https://gitlab.com/max-centre/components/devicexlib/-/archive/%(version)s/']
sources = ['devicexlib-%(version)s.tar.gz']

dependencies = [
    #('FlexiBLAS', '3.4.4'),
]

#preconfigopts = ' && '.join([
    #'export CPP="cpp -P"',
    #'export FPP="cpp -P -traditional"',
    #'export LDFLAGS="-g -pthread -fopenmp"',
#]) + ' && '

configopts = ' '.join([
    #'F90=nvfortran CC=nvc',
    '--enable-cuda-fortran',
    '--enable-openmp',
    '--enable-shared',
    '--enable-parallel',
    '--enable-cuda-env-check',
    '--with-cuda-path=$EBROOTNVHPC/Linux_x86_64/%(toolchain_version)s/cuda/13.1',
    '--with-cuda-cc=80',
    '--with-cuda-runtime=13.1',
    '--with-blas-libs="-L$EBROOTNVHPC/Linux_x86_64/%(toolchain_version)s/REDIST/compilers/lib -lblas"',
])

buildopts = 'all'

local_test_bins = ['buffer', 'linalg', 'malloc', 'mapping', 'memcpy_async', 'memcpy', 'memset', 'pinned']

sanity_check_paths = {
    'files': [f'bin/test_{b}.x' for b in local_test_bins] + ['lib/libdevXlib.a'],
    'dirs': [],
}

sanity_check_commands = [f'test_{b}.x' for b in local_test_bins]

moduleclass = 'lib'
