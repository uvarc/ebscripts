easyblock = 'ConfigureMake'

name = 'libpsl'
version = '0.22.0'

homepage = 'https://rockdaboot.github.io/libpsl'
description = "C library for the Public Suffix List"

toolchain = {'name': 'intel-compilers', 'version': '2025.0.4'}

source_urls = ['https://github.com/rockdaboot/libpsl/releases/download/%(version)s']
sources = [SOURCELOWER_TAR_GZ]

osdependencies = [('python3.11')]

builddependencies = [
    #('binutils', '2.44'),
    #('Python', '3.13.5'),
]

dependencies = [
    #('libidn2', '2.3.8'),
    #('libunistring', '1.3'),
]

sanity_check_commands = [('psl --version')]

sanity_check_paths = {
    'files': ['bin/psl', 'lib/libpsl.a'],
    'dirs': []
}

moduleclass = 'lib'
