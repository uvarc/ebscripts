easyblock = 'MesonNinja'

name = 'librsvg'
version = '2.62.3'

homepage = 'https://wiki.gnome.org/Projects/LibRsvg'
description = "Librsvg is a library to render SVG files using cairo."

toolchain = {'name': 'GCC', 'version': '14.2.0'}

source_urls = ['https://download.gnome.org/sources/%(name)s/%(version_major_minor)s/']
sources = [SOURCE_TAR_XZ]
#patches = ['%(name)s-2.61.0_gdk_pixbuf_loader.patch']

builddependencies = [
    ('binutils', '2.45'),
    ('CMake', '4.2.2'),
    ('Meson', '1.9.0'),
    ('Ninja', '1.13.1'),
    ('pkgconf', '2.4.3'),
    ('Rust', '1.92.0'),
    ('cargo-c', '0.10.15'),
    ('curl', '8.20.0'),
]
dependencies = [
    ('cairo', '1.18.4'),
    ('fontconfig', '2.17.1'),
    ('freetype', '2.14.1'),
    ('Gdk-Pixbuf', '2.42.12'),
    ('HarfBuzz', '12.3.0'),
    ('pango', '1.57.0'),
    ('gobject-introspection', '1.86.0'),
]

preconfigopts = 'sed -i "s/4.0.17/4.5.46/g" %(builddir)s/%(name)s-%(version)s/Cargo.toml && '

# build both static and dynamic libraries
configopts = "-Ddefault_library=both "

modextrapaths = {
    'EB_GDK_PIXBUF_EXTRA_MODULE_FILES': 'lib/gdk-pixbuf-2.0/2.10.0/loaders.cache'
}

sanity_check_paths = {
    'files': ['bin/rsvg-convert', 'lib/%(name)s-%(version_major)s.a', f'lib/%(name)s-%(version_major)s.{SHLIB_EXT}',
              'lib/pkgconfig/%(name)s-%(version_major)s.0.pc'],
    'dirs': ['include/%(name)s-%(version_major)s.0/%(name)s', 'share'],
}

sanity_check_commands = ['rsvg-convert --help']

moduleclass = 'lib'
